                    <li>Đánh giá 7C (Context, Content...)</li>
                    <li>Đủ 5 Web Extensions chuyên sâu</li>
                    <li>Tích hợp Live Typography & Theme</li>
                </ul>
            </div>
            <div>
                <h5 class="font-bold text-stone-200 mb-2">Hotline Hỗ Trợ Đồ Án</h5>
                <p>Nhóm sinh viên TMA306 - Đại học Ngoại Thương</p>
                <p class="text-amber-500 mt-2 font-mono">support@lumenscent.vn</p>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pt-6 border-t border-stone-900 text-center text-stone-600">
            © 2026 LUMEN & SCENT. All rights reserved. Demo website phục vụ báo cáo đồ án TMA306.
        </div>
    </footer>

    <!-- ======================================================== -->
    <!-- JAVASCRIPT: LOGIC ĐỔI FONT, ĐỔI MÀU & 5 EXTENSIONS -->
    <!-- ======================================================== -->
    <script>
        // Khởi tạo Lucide Icons
        lucide.createIcons();

        // ----------------------------------------------------
        // A. QUẢN LÝ FONT & MÀU SẮC (CÔ YÊU CẦU: SỬA LÀ ĐỔI LUÔN)
        // ----------------------------------------------------
        function toggleStudio() {
            const panel = document.getElementById('studioPanel');
            panel.classList.toggle('hidden');
        }

        // Bảng màu cài sẵn (Palettes)
        const palettes = {
            amber: {
                primary: '#b45309',
                primaryHover: '#92400e',
                accent: '#d97706',
                bg: '#faf8f5',
                surface: '#ffffff',
                text: '#292524',
                subtext: '#78716c',
                border: '#e7e5e4'
            },
            sage: {
                primary: '#047857',      /* Emerald 700 */
                primaryHover: '#065f46',
                accent: '#059669',
                bg: '#f2f7f4',            /* Xanh sage nhẹ */
                surface: '#ffffff',
                text: '#132a22',
                subtext: '#4d695e',
                border: '#d1e3d9'
            },
            rose: {
                primary: '#be123c',      /* Rose 700 */
                primaryHover: '#9f1239',
                accent: '#e11d48',
                bg: '#fdf4f5',
                surface: '#ffffff',
                text: '#371821',
                subtext: '#784d58',
                border: '#f5d3d8'
            },
            terracotta: {
                primary: '#c2410c',      /* Orange 700 */
                primaryHover: '#9a3412',
                accent: '#ea580c',
                bg: '#faf5f0',
                surface: '#ffffff',
                text: '#341d13',
                subtext: '#795a4c',
                border: '#eedcd3'
            },
            midnight: {
                primary: '#f59e0b',      /* Amber gold */
                primaryHover: '#d97706',
                accent: '#fbbf24',
                bg: '#0f172a',            /* Dark Slate */
                surface: '#1e293b',
                text: '#f8fafc',
                subtext: '#94a3b8',
                border: '#334155'
            }
        };

        function setPalette(name) {
            const p = palettes[name];
            if (!p) return;
            const root = document.documentElement;
            root.style.setProperty('--primary-color', p.primary);
            root.style.setProperty('--primary-hover', p.primaryHover);
            root.style.setProperty('--accent-color', p.accent);
            root.style.setProperty('--bg-color', p.bg);
            root.style.setProperty('--surface-color', p.surface);
            root.style.setProperty('--text-color', p.text);
            root.style.setProperty('--subtext-color', p.subtext);
            root.style.setProperty('--border-color', p.border);

            document.getElementById('primaryPicker').value = p.primary;
            document.getElementById('accentPicker').value = p.accent;

            // Nếu chọn midnight thì tự bật dark mode
            if (name === 'midnight') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }

        function updateCustomColor(type, colorHex) {
            const root = document.documentElement;
            if (type === 'primary') {
                root.style.setProperty('--primary-color', colorHex);
                root.style.setProperty('--primary-hover', colorHex);
            } else if (type === 'accent') {
                root.style.setProperty('--accent-color', colorHex);
            }
        }

        function changeHeadingFont(fontVal) {
            document.documentElement.style.setProperty('--font-heading', fontVal);
        }

        function changeBodyFont(fontVal) {
            document.documentElement.style.setProperty('--font-body', fontVal);
        }

        function setRadius(radiusVal) {
            document.documentElement.style.setProperty('--radius', radiusVal);
        }

        function toggleDarkMode() {
            document.documentElement.classList.toggle('dark');
        }

        // ----------------------------------------------------
        // B. EXTENSION 1: LIVE CANDLE & LABEL CUSTOMIZER
        // ----------------------------------------------------
        let currentCustomCandle = {
            jar: 'amber',
            jarName: 'Thủy tinh hổ phách',
            jarExtra: 0,
            wick: 'wood',
            wickName: 'Bấc gỗ tự nhiên (Wood Wick)',
            scent: 'Lavender & Sandalwood',
            recipient: 'Hoàng Lan',
            zodiac: '♍ Xử Nữ (Virgo)',
            message: 'Mong bạn luôn an yên và ngập tràn hạnh phúc',
            basePrice: 289000
        };

        function setJarType(jarType) {
            currentCustomCandle.jar = jarType;
            document.querySelectorAll('.jar-option-btn').forEach(b => {
                b.classList.remove('border-amber-600', 'bg-amber-50/50', 'dark:bg-amber-950/20');
                b.classList.add('border-stone-200', 'dark:border-stone-700');
            });
            document.getElementById(`jarBtn-${jarType}`).classList.add('border-amber-600', 'bg-amber-50/50', 'dark:bg-amber-950/20');

            const body = document.getElementById('candleBody');
            if (jarType === 'amber') {
                currentCustomCandle.jarName = 'Thủy tinh hổ phách';
                currentCustomCandle.jarExtra = 0;
                body.className = "w-64 h-72 rounded-3xl p-4 shadow-2xl border transition-all duration-500 flex flex-col justify-center items-center bg-gradient-to-br from-amber-900 via-stone-900 to-stone-950 border-amber-700/50";
            } else if (jarType === 'ceramic') {
                currentCustomCandle.jarName = 'Gốm mộc Bát Tràng (Upcycled)';
                currentCustomCandle.jarExtra = 25000;
                body.className = "w-64 h-72 rounded-3xl p-4 shadow-2xl border transition-all duration-500 flex flex-col justify-center items-center bg-gradient-to-br from-stone-200 via-stone-300 to-stone-400 border-stone-400 text-stone-800";
            } else if (jarType === 'cement') {
                currentCustomCandle.jarName = 'Xi măng Terrazzo';
                currentCustomCandle.jarExtra = 30000;
                body.className = "w-64 h-72 rounded-3xl p-4 shadow-2xl border transition-all duration-500 flex flex-col justify-center items-center bg-gradient-to-br from-stone-600 via-stone-700 to-stone-800 border-stone-500";
            }
            updateCustomizerPrice();
        }

        function setWick(wickType) {
            currentCustomCandle.wick = wickType;
            document.querySelectorAll('.wick-option-btn').forEach(b => {
                b.classList.remove('border-amber-600', 'bg-amber-50/50', 'dark:bg-amber-950/20');
                b.classList.add('border-stone-200', 'dark:border-stone-700');
            });
            document.getElementById(`wickBtn-${wickType}`).classList.add('border-amber-600', 'bg-amber-50/50', 'dark:bg-amber-950/20');

            const wickView = document.getElementById('customWickView');
            if (wickType === 'wood') {
                currentCustomCandle.wickName = 'Bấc gỗ tự nhiên';
                wickView.className = "w-2.5 h-3.5 bg-amber-950 rounded-sm";
            } else {
                currentCustomCandle.wickName = 'Bấc sợi Cotton Organic';
                wickView.className = "w-1 h-3.5 bg-stone-300 rounded-full";
            }
        }

        function updateCustomizerScent(val) {
            currentCustomCandle.scent = val;
            document.getElementById('previewScent').innerText = val;
        }

        function updateLiveLabel() {
            const recipient = document.getElementById('inputRecipient').value || 'Tên người nhận';
            const zodiac = document.getElementById('inputZodiac').value;
            const message = document.getElementById('inputMessage').value || '';

            currentCustomCandle.recipient = recipient;
            currentCustomCandle.zodiac = zodiac;
            currentCustomCandle.message = message;

            document.getElementById('previewRecipient').innerText = recipient;
            document.getElementById('previewZodiac').innerText = zodiac;
            document.getElementById('previewMessage').innerText = `"${message}"`;
        }

        function updateCustomizerPrice() {
            const total = currentCustomCandle.basePrice + currentCustomCandle.jarExtra;
            document.getElementById('customizerPrice').innerText = `${total.toLocaleString('vi-VN')} VNĐ`;
        }

        function toggleCandleFlame() {
            const flame = document.getElementById('customFlame');
            flame.classList.toggle('hidden');
        }

        // ----------------------------------------------------
        // C. EXTENSION 2: SCENT FINDER QUIZ LOGIC
        // ----------------------------------------------------
        let quizAnswers = {};

        function answerQuiz(step, answer) {
            quizAnswers[`step${step}`] = answer;
            if (step === 1) {
                document.getElementById('quizStep1').classList.add('hidden');
                document.getElementById('quizStep2').classList.remove('hidden');
            } else if (step === 2) {
                document.getElementById('quizStep2').classList.add('hidden');
                document.getElementById('quizStep3').classList.remove('hidden');
            } else if (step === 3) {
                document.getElementById('quizStep3').classList.add('hidden');
                calculateQuizResult();
                document.getElementById('quizResult').classList.remove('hidden');
            }
        }

        function calculateQuizResult() {
            const t1 = quizAnswers.step1;
            const t3 = quizAnswers.step3;

            if (t1 === 'stress' || t1 === 'sleep') {
                document.getElementById('resultTitle').innerText = '"Deep Slumber No.04" (Giấc Ngủ Sâu & Bình Yên)';
                document.getElementById('resultTop').innerText = 'Cam Bergamot & Cúc La Mã';
                document.getElementById('resultHeart').innerText = 'Oải hương Pháp & Xô thơm';
                document.getElementById('resultBase').innerText = 'Gỗ tuyết tùng & Hổ phách';
                currentCustomCandle.scent = 'Lavender & Sandalwood';
            } else if (t1 === 'focus') {
                document.getElementById('resultTitle').innerText = '"Focus Flow No.08" (Tỉnh Táo & Làm Việc Sâu)';
                document.getElementById('resultTop').innerText = 'Vỏ bưởi hồng & Lá bạc hà';
                document.getElementById('resultHeart').innerText = 'Trà trắng Nhật Bản & Hoa nhài';
                document.getElementById('resultBase').innerText = 'Gỗ đàn hương & Xạ hương trắng';
                currentCustomCandle.scent = 'White Tea & Cedarwood';
            } else {
                document.getElementById('resultTitle').innerText = '"Cozy Hug No.02" (Ngọt Ngào & Ôm Ấp)';
                document.getElementById('resultTop').innerText = 'Quả mơ chín & Hạnh nhân';
                document.getElementById('resultHeart').innerText = 'Vani Madagascar & Hoa phong lữ';
                document.getElementById('resultBase').innerText = 'Vỏ quế cay & Đậu Tonka';
                currentCustomCandle.scent = 'Vanilla & Cinnamon';
            }
        }

        function applyQuizToCustomizer() {
            document.getElementById('scentSelect').value = currentCustomCandle.scent;
            updateCustomizerScent(currentCustomCandle.scent);
            window.location.hash = '#customizer';
            alert(`Đã áp dụng công thức mùi hương [${currentCustomCandle.scent}] vào studio tự phối nến thành công!`);
        }

        function resetQuiz() {
            quizAnswers = {};
            document.getElementById('quizResult').classList.add('hidden');
            document.getElementById('quizStep1').classList.remove('hidden');
        }

        // ----------------------------------------------------
        // D. EXTENSION 3: GIFT BUNDLE BUILDER
        // ----------------------------------------------------
        let bundleItems = {};

        function toggleBundleItem(id, price, name) {
            if (bundleItems[id]) {
                delete bundleItems[id];
            } else {
                bundleItems[id] = { price, name };
            }
            updateBundleDisplay();
        }

        function updateBundleDisplay() {
            const keys = Object.keys(bundleItems);
            let total = 0;
            keys.forEach(k => total += bundleItems[k].price);

            document.getElementById('bundleTotalPrice').innerText = `${total.toLocaleString('vi-VN')} VNĐ`;

            if (keys.length === 0) {
                document.getElementById('selectedBundleList').innerText = 'Chưa chọn phụ kiện nào';
            } else {
                document.getElementById('selectedBundleList').innerText = keys.map(k => bundleItems[k].name).join(' + ');
            }
        }

        // ----------------------------------------------------
        // E. EXTENSION 4: WEB AUDIO PROCEDURAL FIRE SOUND
        // ----------------------------------------------------
        let audioCtx = null;
        let isPlayingSound = false;
        let noiseNode = null;

        function toggleFireSound() {
            if (!isPlayingSound) {
                startFireSound();
                document.getElementById('soundIcon').setAttribute('data-lucide', 'volume-2');
                document.getElementById('soundText').innerText = 'Âm thanh bấc gỗ: Bật (Tí tách)';
                document.getElementById('soundBtn').classList.add('border-amber-500', 'bg-amber-50', 'text-amber-800');
            } else {
                stopFireSound();
                document.getElementById('soundIcon').setAttribute('data-lucide', 'volume-x');
                document.getElementById('soundText').innerText = 'Âm thanh bấc gỗ: Tắt';
                document.getElementById('soundBtn').classList.remove('border-amber-500', 'bg-amber-50', 'text-amber-800');
            }
            lucide.createIcons();
            isPlayingSound = !isPlayingSound;
        }

        function startFireSound() {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContext();
                
                // Thuật toán giả lập âm thanh lửa nổ tí tách (Crackling Noise)
                const bufferSize = audioCtx.sampleRate * 2;
                const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
                const data = buffer.getChannelData(0);

                for (let i = 0; i < bufferSize; i++) {
                    const white = Math.random() * 2 - 1;
                    // Tạo các đốm nổ ngẫu nhiên (popping crackle)
                    data[i] = Math.random() > 0.994 ? white * 0.8 : white * 0.03;
                }

                noiseNode = audioCtx.createBufferSource();
                noiseNode.buffer = buffer;
                noiseNode.loop = true;

                const filter = audioCtx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.value = 1200;

                const gainNode = audioCtx.createGain();
                gainNode.gain.value = 0.25;

                noiseNode.connect(filter);
                filter.connect(gainNode);
                gainNode.connect(audioCtx.destination);

                noiseNode.start();
            } catch (e) {
                console.log("Audio not allowed before user interaction:", e);
            }
        }

        function stopFireSound() {
            if (noiseNode) {
                noiseNode.stop();
                noiseNode.disconnect();
            }
            if (audioCtx) {
                audioCtx.close();
            }
        }

        // ----------------------------------------------------
        // F. GIỎ HÀNG & MÔ PHỎNG CHECKOUT VIETQR
        // ----------------------------------------------------
        let cart = [];
        let discountRate = 0;

        function addCustomCandleToCart() {
            const item = {
                id: 'candle-' + Date.now(),
                type: 'candle',
                title: `Hũ Nến Custom: ${currentCustomCandle.recipient}`,
                desc: `${currentCustomCandle.jarName} • ${currentCustomCandle.wickName} • Mùi: ${currentCustomCandle.scent} • Cung: ${currentCustomCandle.zodiac}`,
                price: currentCustomCandle.basePrice + currentCustomCandle.jarExtra,
                qty: 1
            };
            cart.push(item);
            updateCartUI();
            toggleCartDrawer();
        }

        function addBundleToCart() {
            const keys = Object.keys(bundleItems);
            if (keys.length === 0) {
                alert('Vui lòng tích chọn ít nhất 1 phụ kiện quà tặng trước!');
                return;
            }
            keys.forEach(k => {
                cart.push({
                    id: 'bundle-' + k + '-' + Date.now(),
                    type: 'bundle',
                    title: bundleItems[k].name,
                    desc: 'Phụ kiện chăm sóc nến chuyên dụng',
                    price: bundleItems[k].price,
                    qty: 1
                });
            });
            // Reset bundle checkbox
            bundleItems = {};
            document.querySelectorAll('.addon-card input[type="checkbox"]').forEach(cb => cb.checked = false);
            updateBundleDisplay();
            updateCartUI();
            toggleCartDrawer();
        }

        function removeCartItem(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function toggleCartDrawer() {
            const drawer = document.getElementById('cartDrawer');
            drawer.classList.toggle('hidden');
        }

        function updateCartUI() {
            document.getElementById('cartCount').innerText = cart.length;

            const container = document.getElementById('cartItemsContainer');
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-stone-400 text-xs">
                        <i data-lucide="shopping-basket" class="w-12 h-12 mx-auto mb-2 opacity-50"></i>
                        Giỏ hàng đang trống. Hãy tạo một hũ nến độc bản ngay nhé!
                    </div>
                `;
                document.getElementById('cartSubtotal').innerText = '0 VNĐ';
                document.getElementById('cartDiscount').innerText = '-0 VNĐ';
                document.getElementById('cartFinalTotal').innerText = '0 VNĐ';
                lucide.createIcons();
                return;
            }

            let subtotal = 0;
            let html = '';

            cart.forEach((item, idx) => {
                subtotal += item.price;
                html += `
                    <div class="p-3.5 rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-800/40 flex items-start justify-between gap-3 text-xs">
                        <div class="flex-1">
                            <h4 class="font-bold text-stone-800 dark:text-stone-100">${item.title}</h4>
                            <p class="text-[11px] text-stone-500 mt-0.5 leading-relaxed">${item.desc}</p>
                            <span class="inline-block mt-1.5 font-bold text-amber-700 dark:text-amber-400">${item.price.toLocaleString('vi-VN')} VNĐ</span>
                        </div>
                        <button onclick="removeCartItem(${idx})" class="text-stone-400 hover:text-red-500 p-1">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                `;
            });

            container.innerHTML = html;

            const discount = Math.round(subtotal * discountRate);
            const finalTotal = subtotal - discount;

            document.getElementById('cartSubtotal').innerText = `${subtotal.toLocaleString('vi-VN')} VNĐ`;
            document.getElementById('cartDiscount').innerText = `-${discount.toLocaleString('vi-VN')} VNĐ`;
            document.getElementById('cartFinalTotal').innerText = `${finalTotal.toLocaleString('vi-VN')} VNĐ`;
            document.getElementById('qrAmount').innerText = `${finalTotal.toLocaleString('vi-VN')} VNĐ`;

            lucide.createIcons();
        }

        function applyCoupon() {
            const code = document.getElementById('couponCode').value.trim().toUpperCase();
            if (code === 'REFILL20') {
                discountRate = 0.20;
                alert('Áp dụng thành công mã REFILL20! Bạn được giảm ngay 20% tổng đơn hàng vì tinh thần tiêu dùng bền vững.');
                updateCartUI();
            } else if (code === '') {
                alert('Vui lòng nhập mã giảm giá!');
            } else {
                alert('Mã giảm giá không hợp lệ. Bạn hãy thử mã [REFILL20] nhé!');
            }
        }

        function openCheckoutModal() {
            if (cart.length === 0) {
                alert('Giỏ hàng trống! Hãy chọn ít nhất 1 sản phẩm trước khi thanh toán.');
                return;
            }
            document.getElementById('checkoutModal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkoutModal').classList.add('hidden');
        }

        function completeOrderSuccess() {
            alert('🎉 Xác nhận đơn hàng thành công! Đội ngũ nghệ nhân LUMEN & SCENT sẽ bắt đầu chế tác hũ nến thủ công và gửi mã vận đơn qua email của bạn.');
            cart = [];
            discountRate = 0;
            updateCartUI();
            closeCheckoutModal();
            toggleCartDrawer();
        }
    </script>
</body>
</html>
